# Local development only. Set a separate managed secret for any hosted database.
POSTGRES_PASSWORD=commutecircle-local-only
DATABASE_URL=postgresql+psycopg://commutecircle:commutecircle-local-only@localhost:5432/commutecircle
# Leave all three unset until configuring an OIDC provider. Ride APIs fail closed.
# Use an API-specific audience and RS256 access tokens with rides:read/rides:write scopes.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Optional public client ID for local Swagger sign-in; no client secret.
DOCS_OAUTH_CLIENT_ID=

# Exact comma-separated origins for a separately hosted frontend (optional).
WEB_ORIGINS=

# Optional transactional alerts; configure server-side only. See docs/booking-notifications.md.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_VERIFY_SERVICE_SID=
