# Local development only. Set a separate managed secret for any hosted database.
POSTGRES_PASSWORD=commutecircle-local-only
DATABASE_URL=postgresql+psycopg://commutecircle:commutecircle-local-only@localhost:5432/commutecircle
# Public development Auth0 identifiers from the existing Render staging blueprint.
# These are not secrets. An Auth0 administrator must still configure allowed
# callbacks and user-delegated API permissions. Use separate values for production.
# Never commit credentials, access tokens, or a local .env file.
OIDC_ISSUER=https://dev-k7el8butwnjlle3n.us.auth0.com/
OIDC_AUDIENCE=https://commutecircle-api
OIDC_JWKS_URL=https://dev-k7el8butwnjlle3n.us.auth0.com/.well-known/jwks.json

# Public development client ID for local Studio and Swagger. No client secret.
DOCS_OAUTH_CLIENT_ID=6malfyYSWlRbe2whqk8iSS5zRl2H8yN6
V2_REQUIRE_DRIVER_VERIFICATION=false

# Exact comma-separated origins for a separately hosted frontend (optional).
WEB_ORIGINS=

# Optional transactional alerts; configure server-side only. See docs/booking-notifications.md.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_VERIFY_SERVICE_SID=
